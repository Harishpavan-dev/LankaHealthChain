# DEVELOPMENT ONLY. Replace every secret before any deployment.
NODE_ENV=development
PORT=3000
POSTGRES_HOST_PORT=5432
KEYCLOAK_HOST_PORT=8080
MIDNIGHT_PROOF_HOST_PORT=6300
NEXT_PORT=3001
WEB_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
HOSPITAL_NORTHERN_PORT=4101
HOSPITAL_JAFFNA_PORT=4102
HOSPITAL_VENUS_PORT=4103
# Assign unique PostgreSQL passwords; Docker Compose initializes separate database owners.
POSTGRES_PASSWORD=CHANGE_BOOTSTRAP_DB_PASSWORD
KEYCLOAK_ADMIN_PASSWORD=CHANGE_KEYCLOAK_ADMIN_PASSWORD
LHC_CORE_DB_PASSWORD=CHANGE_CORE_DB_PASSWORD
LHC_NORTHERN_DB_PASSWORD=CHANGE_NORTHERN_DB_PASSWORD
LHC_JAFFNA_DB_PASSWORD=CHANGE_JAFFNA_DB_PASSWORD
LHC_VENUS_DB_PASSWORD=CHANGE_VENUS_DB_PASSWORD
DATABASE_URL=postgresql://lhc_core:CHANGE_CORE_DB_PASSWORD@localhost:5432/lankahealthchain_core?schema=public
HOSPITAL_NORTHERN_DATABASE_URL=postgresql://lhc_northern:CHANGE_NORTHERN_DB_PASSWORD@localhost:5432/hospital_northern?schema=public
HOSPITAL_JAFFNA_DATABASE_URL=postgresql://lhc_jaffna:CHANGE_JAFFNA_DB_PASSWORD@localhost:5432/hospital_jaffna?schema=public
HOSPITAL_VENUS_DATABASE_URL=postgresql://lhc_venus:CHANGE_VENUS_DB_PASSWORD@localhost:5432/hospital_venus?schema=public
# Local Keycloak realm URL (browser and backend use same issuer for local dev)
OIDC_ISSUER=http://localhost:8080/realms/lankahealthchain
OIDC_AUDIENCE=lhc-api
# Docker-only JWKS URL (the browser uses OIDC_ISSUER).
OIDC_JWKS_INTERNAL_URL=http://keycloak:8080/realms/lankahealthchain/protocol/openid-connect/certs
NEXT_PUBLIC_OIDC_URL=http://localhost:8080
NEXT_PUBLIC_OIDC_REALM=lankahealthchain
NEXT_PUBLIC_OIDC_CLIENT_ID=lhc-web
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Optional synthetic demo identifier. Never add real patient identifiers here.
NEXT_PUBLIC_DEMO_PATIENT_ID=b1111111-1111-4111-8111-111111111111
# Each site has its own scoped internal service-token signing secret.
HOSPITAL_NORTHERN_TOKEN_SECRET=CHANGE_NORTHERN_SERVICE_SECRET_WITH_64_RANDOM_CHARACTERS
HOSPITAL_JAFFNA_TOKEN_SECRET=CHANGE_JAFFNA_SERVICE_SECRET_WITH_64_RANDOM_CHARACTERS
HOSPITAL_VENUS_TOKEN_SECRET=CHANGE_VENUS_SERVICE_SECRET_WITH_64_RANDOM_CHARACTERS
# Set HOSPITAL_TOKEN_SECRET to the appropriate site secret in each hospital terminal.
HOSPITAL_TOKEN_SECRET=CHANGE_NORTHERN_SERVICE_SECRET_WITH_64_RANDOM_CHARACTERS
HOSPITAL_NORTHERN_URL=http://localhost:4101
HOSPITAL_JAFFNA_URL=http://localhost:4102
HOSPITAL_VENUS_URL=http://localhost:4103
# Network-local Docker URLs are intentionally separate from host URLs.
HOSPITAL_NORTHERN_INTERNAL_URL=http://hospital-northern:4101
HOSPITAL_JAFFNA_INTERNAL_URL=http://hospital-jaffna:4102
HOSPITAL_VENUS_INTERNAL_URL=http://hospital-venus:4103
HOSPITAL_CODE=northern
# Hospital service uses PORT=4101, 4102 or 4103 per process.
HOSPITAL_DATABASE_URL=postgresql://lhc_northern:CHANGE_NORTHERN_DB_PASSWORD@localhost:5432/hospital_northern?schema=public
# local-demo is NOT a Midnight proof. production-like mode requires real Midnight verification.
CONSENT_MODE=local-demo
# No live Cardano / Midnight integration has been configured yet.
CARDANO_NETWORK=preprod
# Provider endpoint can be replaced without changing application code.
CARDANO_METADATA_API_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_PREPROD_PROJECT_ID=
MIDNIGHT_NETWORK=testnet

# Research aggregation is synthetic only; production explicitly denies this feature.
RESEARCH_MODE=synthetic-demo

# Poll cadence for background Merkle preparation (ms; 5000..600000).
WORKER_POLL_MS=15000

# Disposable synthetic-only Keycloak accounts; generated randomly by setup-local.mjs.
LHC_DEMO_PATIENT_PASSWORD=CHANGE_DEMO_PATIENT_PASSWORD
LHC_DEMO_DOCTOR_PASSWORD=CHANGE_DEMO_DOCTOR_PASSWORD
LHC_DEMO_ADMIN_PASSWORD=CHANGE_DEMO_ADMIN_PASSWORD
LHC_DEMO_HOSPITAL_PASSWORD=CHANGE_DEMO_HOSPITAL_PASSWORD
LHC_DEMO_AUDITOR_PASSWORD=CHANGE_DEMO_AUDITOR_PASSWORD
LHC_DEMO_RESEARCHER_PASSWORD=CHANGE_DEMO_RESEARCHER_PASSWORD
