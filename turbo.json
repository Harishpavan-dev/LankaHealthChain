{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**", "generated/**", ".next/**"
      ],
      "env": ["LHC_FRONTEND_STANDALONE", "NEXT_PUBLIC_OIDC_URL", "NEXT_PUBLIC_OIDC_REALM", "NEXT_PUBLIC_OIDC_CLIENT_ID", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_DEMO_PATIENT_ID"]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@lhc/database#typecheck": { "dependsOn": ["build"] },
    "@lhc/hospital-database#typecheck": { "dependsOn": ["build"] },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": { "dependsOn": ["^build"] },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
