{
  "realm": "lankahealthchain",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "patient"
      },
      {
        "name": "doctor"
      },
      {
        "name": "network_admin"
      },
      {
        "name": "hospital_admin"
      },
      {
        "name": "security_auditor"
      },
      {
        "name": "researcher"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lhc-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*",
        "http://localhost:5176/*",
        "http://localhost:5177/*",
        "http://localhost:5178/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:5175",
        "http://localhost:5176",
        "http://localhost:5177",
        "http://localhost:5178"
      ],
      "protocolMappers": [
        {
          "name": "lhc-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lhc-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lhc-api",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": false
    },
    {
