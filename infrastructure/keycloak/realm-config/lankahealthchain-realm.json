{
  "realm": "lankahealthchain",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "patient"
      },
      {
        "name": "doctor"
      },
      {
        "name": "network_admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lhc-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:5175"
      ],
      "protocolMappers": [
        {
          "name": "lhc-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lhc-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lhc-api",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "patient.arun",
      "enabled": true,
      "emailVerified": true,
      "email": "patient@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "DemoPatient123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "patient"
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "doctor.venus",
      "enabled": true,
      "emailVerified": true,
      "email": "doctor@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "DemoDoctor123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "doctor"
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "admin.network",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "DemoAdmin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "network_admin"
      ]
    }
  ]
}
