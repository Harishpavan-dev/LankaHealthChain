FROM node:22.22.3-bookworm-slim AS build
WORKDIR /workspace
ENV CI=true NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate
COPY . .
RUN --mount=type=cache,id=lhc-pnpm-10,target=/pnpm/store,sharing=locked \
 pnpm --filter @lhc/frontend install --frozen-lockfile --prefer-offline --store-dir /pnpm/store
ARG NEXT_PUBLIC_OIDC_URL
ARG NEXT_PUBLIC_OIDC_REALM
ARG NEXT_PUBLIC_OIDC_CLIENT_ID
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DEMO_PATIENT_ID
RUN test -n "$NEXT_PUBLIC_OIDC_URL" \
 && test -n "$NEXT_PUBLIC_OIDC_REALM" \
 && test -n "$NEXT_PUBLIC_OIDC_CLIENT_ID" \
 && test -n "$NEXT_PUBLIC_API_URL" \
 && LHC_FRONTEND_STANDALONE=1 pnpm --filter @lhc/frontend build

FROM node:22.22.3-bookworm-slim AS frontend
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3001
COPY --from=build --chown=node:node /workspace/frontend/.next/standalone ./
COPY --from=build --chown=node:node /workspace/frontend/.next/static ./frontend/.next/static
USER node
EXPOSE 3001
CMD ["node", "frontend/server.js"]
