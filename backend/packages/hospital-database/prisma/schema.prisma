generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model MedicalRecord {
  id             String   @id @default(uuid()) @db.Uuid
  externalId     String
  localPatientId String
  resourceType   String
  version        Int
  fhir           Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@unique([externalId, version])
  @@index([localPatientId, resourceType])
}

/** Replay protection shared by all replicas of one Hospital API. */
model UsedServiceToken {
  jti       String   @id @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime @default(now()) @db.Timestamptz(3)
  @@index([expiresAt])
}
