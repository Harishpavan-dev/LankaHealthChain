generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id         String               @id @default(uuid()) @db.Uuid
  code       String               @unique
  name       String
  baseUrl    String
  active     Boolean              @default(true)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  doctors    Doctor[]
  identities PatientIdentityMap[]
  records    MedicalRecordIndex[]
  operators  HospitalOperator[]
  administrativeEvents AdministrativeAuditEvent[]
}

model Patient {
  id           String               @id @default(uuid()) @db.Uuid
  authSubject  String               @unique
  displayName  String               // Synthetic demonstration labels only
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  identities   PatientIdentityMap[]
  records      MedicalRecordIndex[]
  requests     AccessRequest[]
  consents     Consent[]
  auditEvents  AuditEvent[]
}

model Doctor {
  id           String          @id @default(uuid()) @db.Uuid
  authSubject  String          @unique
  displayName  String
  hospitalId   String          @db.Uuid
  active       Boolean         @default(true)
  verified     Boolean         @default(false)
  hospital     Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  requests     AccessRequest[]
  @@index([hospitalId, active])
}

model PatientIdentityMap {
  id              String    @id @default(uuid()) @db.Uuid
  patientId       String    @db.Uuid
  hospitalId      String    @db.Uuid
  localPatientRef String    // Synthetic opaque ID; production: encrypt at rest
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  @@unique([patientId, hospitalId])
  @@unique([hospitalId, localPatientRef])
}

model MedicalRecordIndex {
  id                  String         @id @default(uuid()) @db.Uuid
  patientId           String         @db.Uuid
  hospitalId          String         @db.Uuid
  remoteRecordId      String
  resourceType        String
  recordVersion       Int
  integrityCommitment String         @unique
  nonceHex            String         // Off-chain secret, never upload to a public chain
  anchorStatus        String         @default("PENDING")
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  hospital            Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  anchors             RecordAnchor[]
  @@unique([hospitalId, remoteRecordId, recordVersion])
  @@index([patientId, resourceType])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([patientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([anchorStatus, createdAt])
}

model AccessRequest {
  id                       String       @id @default(uuid()) @db.Uuid
  patientId                String       @db.Uuid
  doctorId                 String       @db.Uuid
  purpose                  String
  requestedTypes           String[]
  requestedDurationMinutes Int
  clientRequestKey         String?      @db.VarChar(128)
  clientRequestFingerprint String?      @db.VarChar(64)
  decisionDeadlineAt       DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP + interval '24 hours')")) @db.Timestamptz(3)
  status                   String       @default("PENDING")
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  patient                  Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                   Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  consent                  Consent?
  @@index([patientId, status])
  @@index([patientId, status, decisionDeadlineAt])
  @@index([doctorId, createdAt])
  @@index([doctorId, createdAt(sort: Desc), id(sort: Desc)])
  @@unique([doctorId, clientRequestKey])
}

model Consent {
  id                String        @id @default(uuid()) @db.Uuid
  requestId         String        @unique @db.Uuid
  patientId         String        @db.Uuid
  doctorId          String        @db.Uuid
  hospitalId        String        @db.Uuid
  purpose           String
  allowedTypes      String[]
  status            String        @default("ACTIVE")
  expiresAt         DateTime      @db.Timestamptz(3)
  revokedAt         DateTime?     @db.Timestamptz(3)
  midnightProofRef  String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  request           AccessRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  @@index([doctorId, status, expiresAt])
  @@index([patientId, createdAt(sort: Desc)])
  @@index([patientId, createdAt(sort: Desc), id(sort: Desc)])
}

model RecordAnchor {
  id             String             @id @default(uuid()) @db.Uuid
  recordIndexId  String             @db.Uuid
  batchId        String?
  cardanoTxHash  String?
  inclusionProof Json?
  status         String             @default("PENDING")
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  record         MedicalRecordIndex @relation(fields: [recordIndexId], references: [id], onDelete: Restrict)
  @@index([recordIndexId])
  @@index([batchId, status])
  @@unique([recordIndexId, batchId])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  actorSub      String
  action        String
  requestId     String?  @db.Uuid
  recordIndexId String?  @db.Uuid
  outcome       String
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  @@index([patientId, createdAt(sort: Desc)])
  @@index([patientId, createdAt(sort: Desc), id(sort: Desc)])
}

model OutboxEvent {
  id           String    @id @default(uuid()) @db.Uuid
  eventType    String
  aggregateId  String    @db.Uuid
  payload      Json
  attempts     Int       @default(0)
  publishedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  @@index([publishedAt, createdAt])
  @@unique([eventType, aggregateId])
}

// Operators are enrolled by network administration, never through a user-controlled JWT claim.
model HospitalOperator {
  id           String    @id @default(uuid()) @db.Uuid
  authSubject  String
  hospitalId   String    @db.Uuid
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  hospital     Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  @@unique([authSubject, hospitalId])
  @@index([hospitalId, active])
}

// Synthetic-data-only research grant. Not a substitute for research ethics review.
model ResearchGrant {
  id           String    @id @default(uuid()) @db.Uuid
  authSubject  String    @unique
  projectName  String
  purpose      String
  active       Boolean   @default(true)
  approvedAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  @@index([active, expiresAt])
}

// Separate append-only operations audit; deliberately excludes clinical payloads.
model AdministrativeAuditEvent {
  id          String    @id @default(uuid()) @db.Uuid
  hospitalId  String?   @db.Uuid
  actorSub    String
  action      String
  targetKind  String
  targetId    String
  outcome     String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  @@index([hospitalId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}
