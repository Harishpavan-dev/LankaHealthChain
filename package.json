{
  "name": "lankahealthchain",
  "version": "0.13.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev:api": "pnpm --filter @lhc/api dev",
    "dev:hospital": "pnpm --filter @lhc/hospital-simulator dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:all": "pnpm test && pnpm test:protocol && pnpm docs:check && turbo test",
    "db:generate": "pnpm --filter @lhc/database db:generate && pnpm --filter @lhc/hospital-database db:generate",
    "db:migrate": "pnpm --filter @lhc/database db:migrate && pnpm --filter @lhc/hospital-database db:migrate:all",
    "db:seed": "pnpm --filter @lhc/database db:seed && pnpm --filter @lhc/hospital-database db:seed:all",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "setup:local": "node scripts/setup-local.mjs",
    "test:protocol": "node --experimental-strip-types --test tests/integration/*.test.mjs",
    "anchors:prepare": "pnpm --filter @lhc/worker prepare:anchors",
    "check:syntax": "node scripts/qa/syntax-check.cjs",
    "test:live-smoke": "node scripts/qa/live-smoke.mjs",
    "contracts:midnight:compile": "bash contracts/midnight/scripts/compile.sh",
    "preflight": "node scripts/qa/preflight.mjs",
    "test:live-flow": "node scripts/qa/live-flow.mjs",
    "db:verify-isolation": "pnpm --filter @lhc/database db:verify-isolation",
    "docs:check": "node scripts/qa/verify-openapi.mjs && node --experimental-strip-types --test tests/unit/postman-contract.test.mjs",
    "docs:postman": "node scripts/qa/generate-postman.mjs",
    "test:live-governance": "node scripts/qa/live-governance.mjs",
    "config:audit": "node scripts/qa/config-audit.mjs",
    "dev:frontend": "pnpm --filter @lhc/frontend dev",
    "build:frontend": "pnpm --filter @lhc/frontend build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "turbo": "^2.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.15.0"
  }
}
